# Copy to .env and adjust as needed. See README.md "Local development" for setup.

NODE_ENV=development

# Matches docker-compose.yml's postgres service (host port 55432, chosen to
# avoid colliding with other local Postgres instances on 5432).
DATABASE_URL="postgresql://sparki:sparki@localhost:55432/sparki?schema=public"

API_PORT=4000
API_URL="http://localhost:4000"
WEB_PORT=3001

# Origin the API accepts browser requests from (apps/web in dev).
CORS_ORIGIN="http://localhost:3001"

# WorkOS AuthKit (docs/engineering/00-engineering-plan.md). WorkOS owns
# authentication (credentials, password storage, sessions); Sparki's own
# User/StaffProfile own role and clinic membership (see prisma/schema.prisma).
# Leave all three blank to keep using DevelopmentAuthGuard's fake OWNER user
# (no real login). Set all three from your WorkOS dashboard's API keys page
# to enable real sign-in — apps/api/src/auth/auth.module.ts switches to the
# real AuthGuard automatically once they're present.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI="http://localhost:4000/auth/callback"
# Encrypts the sealed session cookie. Any random string >=32 chars, e.g.
# `openssl rand -base64 32`. Not a WorkOS credential — you generate this
# yourself; it never leaves your server.
WORKOS_COOKIE_PASSWORD=

# Optional live owner address search. Set a server-side Mapbox Search Box API
# token to enable address suggestions in the New Patient modal. Leave blank to
# keep manual address entry only.
MAPBOX_ACCESS_TOKEN=
