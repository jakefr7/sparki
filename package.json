{
  "name": "sparki",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/run-isolated-tests.test.mjs",
    "test:integration": "dotenv -e .env -- node scripts/run-isolated-tests.mjs integration",
    "test:e2e": "dotenv -e .env -- node scripts/run-isolated-tests.mjs playwright",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @sparki/db run generate",
    "db:migrate": "pnpm --filter @sparki/db run migrate",
    "db:seed-demo": "dotenv -e .env -- node scripts/reset-demo-clinic-data.mjs",
    "db:seed-auth-users": "dotenv -e .env -- node scripts/seed-auth-users.mjs",
    "seed:local-demo": "dotenv -e .env -- node scripts/seed-local-clinic-demo-data.mjs",
    "seed:inventory": "dotenv -e .env -- node scripts/seed-inventory-pass-1.mjs && dotenv -e .env -- node scripts/seed-inventory-pass-2.mjs && dotenv -e .env -- node scripts/seed-inventory-pass-3.mjs && dotenv -e .env -- node scripts/seed-inventory-pass-4.mjs && dotenv -e .env -- node scripts/seed-inventory-pass-5.mjs",
    "seed:inventory:refresh-expirations": "dotenv -e .env -- node scripts/seed-inventory-pass-1.mjs --refresh-expirations",
    "cleanup:test-debris": "dotenv -e .env -- node scripts/cleanup-local-test-debris.mjs",
    "sparki:dev": "dotenv -e .env -- node scripts/sparki-local.mjs dev",
    "sparki:doctor": "dotenv -e .env -- node scripts/sparki-local.mjs doctor",
    "sparki:status": "node scripts/agent/status.mjs",
    "sparki:plan": "node scripts/agent/orchestrator.mjs plan",
    "sparki:execute": "CLAUDE_BIN=./scripts/agent/claude-sparki node scripts/agent/orchestrator.mjs execute",
    "sparki:review": "CLAUDE_BIN=./scripts/agent/claude-sparki node scripts/agent/orchestrator.mjs review",
    "test:agent": "node --test scripts/agent/*.test.mjs",
    "test:verification-infrastructure": "node --test scripts/run-isolated-tests.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@prisma/client": "5.22.0",
    "@types/node": "^20.14.0",
    "@workos-inc/node": "^7.24.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  }
}
