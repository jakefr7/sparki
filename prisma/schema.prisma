// An authorized order is distinct from the editable medication profile and from dispensing.
model PatientPrescription {
  id String @id @default(cuid())
  organizationId String
  locationId String
  patientId String
  catalogItemId String? @db.Uuid
  medicationName String
  strength String
  form String?
  directions String
  quantity Decimal @db.Decimal(18, 8)
  quantityUnit String
  allowedRefills Int @default(0)
  expiresAt DateTime
  status String @default("DRAFT")
  version Int @default(1)
  preparedById String
  authorizedById String?
  authorizedByName String?
  licenseNumber String?
  authorizedAt DateTime?
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields: [patientId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id])
  preparedBy User @relation("PrescriptionPreparedBy", fields: [preparedById], references: [id])
  authorizedBy User? @relation("PrescriptionAuthorizedBy", fields: [authorizedById], references: [id])
  events PatientPrescriptionEvent[]
  @@index([organizationId, locationId, patientId, createdAt])
}

model PatientPrescriptionEvent {
  id String @id @default(cuid())
  prescriptionId String
  organizationId String
  actorId String
  action String
  metadata Json?
  createdAt DateTime @default(now())
  prescription PatientPrescription @relation(fields: [prescriptionId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
  @@index([organizationId, prescriptionId, createdAt])
}
