  organizationId String
  attachmentId   String
  actorId        String
  action         String
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id])
  attachment   ClinicalAttachment @relation(fields: [attachmentId], references: [id])
  actor        User               @relation("ClinicalAttachmentEventActor", fields: [actorId], references: [id])

  @@index([organizationId, attachmentId, createdAt])
