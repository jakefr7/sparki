  sourceRecordType   String
  sourceRecordId     String
  sourceEventVersion Int                       @default(1)
  patientId          String?
  clientId           String?
  visitId            String?
  appointmentId      String?
  invoiceId          String?
  invoiceLineId      String?
  medicationOrderId  String?
  administrationId   String?
  prescriptionId     String?
  dispensingRecordId String?
  vaccineRecordId    String?
  laboratoryRecordId String?
  procedureRecordId  String?
  mappingId          String?                   @db.Uuid
  mappingVersion     Int?
  mappingSnapshot    Json?
  status             InventoryUsageEventStatus @default(PENDING)
  failureCode        String?
  failureMessage     String?
