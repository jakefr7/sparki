// Minimum schema for Sprint 1's vertical slice (login -> patient search ->
// patient workspace -> schedule appointment -> create visit -> update visit
// state -> create medical record -> persist data). See
// docs/engineering/00-engineering-plan.md.
//
// Scope, deliberately narrow:
// - Only Organization, Location, User, StaffProfile, Patient, Client,
//   Appointment, Visit, MedicalRecord, plus SoapNote (the minimum content
//   model needed to make MedicalRecord usable for Sprint 1's "create draft
//   SOAP Note" step —
//   folds in what docs/blueprint/08-core-domain-model-v1.md calls "Visit
//   Record Entry", since for this slice they are the same thing).
// - Event, Audit Event, Billing, Inventory, Labs, Communication, and AI
//   fields are deferred until an implementation task needs them.
// - Enum values mirror the exact state names in
//   docs/specs/modules/02-visit-lifecycle-mvp.md and
//   docs/specs/modules/04-scheduling-mvp.md; do not rename or trim them here.
// - Migration/provenance fields (sourceSystem, sourceId, sourceConfidence,
//   importedAt) live on every core tenant record that may originate from a
//   legacy system (Patient, Client, Appointment, MedicalRecord, SoapNote) per
//   ADR-003 and docs/blueprint/06-migration-strategy.md: migration is a
//   first-class concern, so provenance is captured from day one rather than
//   retrofitted once a migration workflow exists. No migration workflow or
//   service is implemented here — these are bare columns only.

generator client {
  provider        = "prisma-client-js"
  output          = "../packages/db/generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

// pg_trgm backs the GIN trigram indexes on Patient.name / Client.name used by
// Patient Search's fuzzy matching (docs/specs/modules/01-patient-workspace-mvp.md
// "Open Patient From Search"; docs/engineering/00-engineering-plan.md
// recommends trigram indexes for patient search before reaching for a
// separate search service).
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// --- Organization / Location / User / StaffProfile -----------------------
// docs/blueprint/08-core-domain-model-v1.md (Organization, Location, User)
// and docs/blueprint/11-permission-and-ownership-v1.md (isolation). Role is
// identity only (fixed UserRole enum below) — no permission framework yet.

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

model Organization {
  prescriptions PatientPrescription[]
  prescriptionEvents PatientPrescriptionEvent[]
  id        String  @id @default(cuid())
  name      String
  legalName String?
  phone     String?
  email     String?
  teamSize  String?

  // Structured clinic address, same shape as Client's (see Client model
  // below) — discrete columns rather than one string so city/state/zip stay
  // queryable/reportable later (billing, tax, clinic directories).
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  // Clinic-wide default time zone, used to seed the first Location's
  // authoritative Location.timeZone during setup. Location remains the
  // source of truth for scheduling; this is the clinic-level default shown
  // during onboarding and for any future additional Location.
  timezone String?

  // --- Sparki subscription / billing state (docs/adr/ADR-007) ------------
  // Organization is the Sparki billing tenant: one clinic, one Stripe
  // customer, one active subscription. Authoritative only from
  // billing-webhook-verified state (see apps/api/src/billing) — never from a
  // client-supplied value. Defaults to ACTIVE because every *existing*
  // Organization-creating code path (dev seeds, other modules' fixtures)
  // predates billing and has no reason to be gated; only
  // ClinicProvisioningService (driven by a verified Stripe webhook event)
  // ever creates an Organization with a non-ACTIVE status, and it always
  // sets one explicitly.
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  // Guards against out-of-order webhook delivery: an incoming event only
  // updates subscriptionStatus if its own Stripe `created` timestamp is at
  // least this recent. Null means status has never been set from a webhook.
  subscriptionStatusUpdatedAt DateTime?
  stripeCustomerId            String?   @unique
  stripeSubscriptionId        String?   @unique
  subscriptionPriceId         String?
  subscriptionCurrentPeriodEnd DateTime?

  // Set once the owner finishes the /setup wizard (clinic profile step, plus
  // an explicit "finish setup" action — team invites are optional). Null
  // means onboarding is still in progress.
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations                    Location[]
  users                        User[]
  clients                      Client[]
  patients                     Patient[]
  patientAlerts                PatientAlert[]
  patientMedications           PatientMedication[]
  patientMedicationEvents      PatientMedicationEvent[]
  appointments                 Appointment[]
  appointmentChanges           AppointmentChange[]
  schedulerConfigChanges       SchedulerConfigChange[]
  visits                       Visit[]
  appointmentTypeSettings      AppointmentTypeSetting[]
  appointmentTypeProviders     AppointmentTypeProvider[]
  schedulerSettings            SchedulerSettings[]
  schedulerSlotTemplates       SchedulerSlotTemplate[]
  dashboardStatusColorSettings DashboardStatusColorSetting[]
  notes                        Note[]
  tasks                        Task[]
  conversations                MessagingConversation[]
  messages                     MessagingMessage[]
  messageAttachments           MessagingAttachment[]
  clinicalAttachments          ClinicalAttachment[]
  clinicalAttachmentEvents     ClinicalAttachmentEvent[]
  clientCommunicationThreads   ClientCommunicationThread[]
  clientCommunicationMessages  ClientCommunicationMessage[]
  visitTransitions             VisitTransition[]
  visitWorkItems               VisitWorkItem[]
  visitExceptions              VisitException[]
  visitHandoffs                VisitHandoff[]
  catalogItems                 CatalogItem[]
  stockLocations               StockLocation[]
  inventoryTransactions        InventoryTransaction[]
  invoices                     Invoice[]
  invoiceLines                 InvoiceLine[]
  payments                     Payment[]

  memberships    OrganizationMembership[]
  locationAccess ClinicLocationAccess[]
  invitations    ClinicInvitation[]
  events         OrganizationEvent[]
}

model Location {
  prescriptions PatientPrescription[]
  id             String   @id @default(cuid())
  organizationId String
  name           String
  timeZone       String   @default("America/Chicago")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                 Organization                  @relation(fields: [organizationId], references: [id])
  users                        User[]
  appointments                 Appointment[]
  appointmentChanges           AppointmentChange[]
  schedulerConfigChanges       SchedulerConfigChange[]
  visits                       Visit[]
  appointmentTypeSettings      AppointmentTypeSetting[]
  schedulerSettings            SchedulerSettings?
  schedulerSlotTemplates       SchedulerSlotTemplate[]
  dashboardStatusColorSettings DashboardStatusColorSetting[]
  tasks                        Task[]
  conversations                MessagingConversation[]
  clientCommunicationThreads   ClientCommunicationThread[]
  visitTransitions             VisitTransition[]
  visitWorkItems               VisitWorkItem[]
  visitExceptions              VisitException[]
  visitHandoffs                VisitHandoff[]
  catalogItems                 CatalogItem[]
  stockLocations               StockLocation[]
  inventoryTransactions        InventoryTransaction[]
  clinicalAttachments          ClinicalAttachment[]
  invoices                     Invoice[]

  // Location-level policy: clinics may allow operational checkout while an
  // invoice balance remains open. The balance itself stays visible work.
  allowCheckoutWithOutstandingBalance Boolean @default(false)

  locationAccess ClinicLocationAccess[]

  @@index([organizationId])
}

// Role is identity only for v1 — no permission framework. A fixed enum
// (rather than the administrable Role table this replaces) matches that: the
// only thing a Role currently drives is "what kind of person is this",
// not what they're allowed to do.
enum UserRole {
  OWNER
  PRACTICE_MANAGER
  RECEPTIONIST
  VETERINARIAN
  TECHNICIAN
  ASSISTANT
  CLIENT
}

model User {
  preparedPrescriptions PatientPrescription[] @relation("PrescriptionPreparedBy")
  authorizedPrescriptions PatientPrescription[] @relation("PrescriptionAuthorizedBy")
  prescriptionEvents PatientPrescriptionEvent[]
  id                          String   @id @default(cuid())
  organizationId              String
  email                       String   @unique
  phone                       String?
  firstName                   String
  lastName                    String
  // Override for the two-line firstName/lastName default (e.g. "Dr. Priya
  // Shah") — nullable because most users are fine with the computed default.
  displayName                 String?
  avatarUrl                   String?
  statusEmoji                 String?
  statusText                  String?
  role                        UserRole
  isActive                    Boolean  @default(true)
  // Sparki owns authorization; WorkOS AuthKit owns authentication (see
  // apps/api/src/auth). Nullable until real sign-in issues this.
  workosUserId                String?  @unique
  // Cooldown guard for POST /auth/email-code/request (WorkOS Magic Auth) —
  // prevents a single account from triggering unlimited code sends. See
  // AuthService.requestEmailCode.
  lastEmailCodeRequestedAt    DateTime?
  // Explicit per-user grant, independent of Role — Settings > Admin (scheduler
  // settings + dashboard status colors) is deliberately not tied to any
  // Role so any team member can be granted it individually without a role
  // change pulling in that role's other capabilities. See
  // apps/api/src/auth/permissions.ts.
  canManageAdminSettings      Boolean  @default(false)
  // Explicit grant for a veterinarian or other legally eligible user who may
  // be delegated final record signoff when they are not the assigned doctor.
  canFinalizeRecordsForOthers Boolean  @default(false)
  canManageMedications        Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  locations    Location[]
  staffProfile StaffProfile?

  // Normalized org/location grants (see ADR-006). AuthService.resolveMembership
  // reads these, not organizationId/role/locations above, to build the
  // request's AuthenticatedUser — those older fields are kept live only for
  // staff.service.ts and dev-seed compatibility during the transition, not
  // removed yet.
  organizationMemberships OrganizationMembership[]
  clinicLocationAccess    ClinicLocationAccess[]

  createdAppointments        Appointment[]             @relation("AppointmentCreatedBy")
  providedAppointments       Appointment[]             @relation("AppointmentProvider")
  appointmentChanges         AppointmentChange[]       @relation("AppointmentChangeActor")
  schedulerConfigChanges     SchedulerConfigChange[]   @relation("SchedulerConfigChangeActor")
  appointmentTypeAssignments AppointmentTypeProvider[]

  ownedVisits               Visit[] @relation("VisitOwner")
  primaryVeterinarianVisits Visit[] @relation("VisitPrimaryVeterinarian")
  assignedTechnicianVisits  Visit[] @relation("VisitAssignedTechnician")
  createdVisits             Visit[] @relation("VisitCreatedBy")
  lastUpdatedVisits         Visit[] @relation("VisitLastUpdatedBy")

  authoredSoapNotes         SoapNote[]                   @relation("SoapNoteAuthor")
  signedSoapNotes           SoapNote[]                   @relation("SoapNoteVeterinarian")
  visitTransitions          VisitTransition[]            @relation("VisitTransitionActor")
  assignedVisitWorkItems    VisitWorkItem[]              @relation("VisitWorkItemAssignee")
  completedVisitWorkItems   VisitWorkItem[]              @relation("VisitWorkItemCompletedBy")
  visitWorkItemChanges      VisitWorkItemChange[]        @relation("VisitWorkItemChangeActor")
  createdVisitExceptions    VisitException[]             @relation("VisitExceptionCreatedBy")
  ownedVisitExceptions      VisitException[]             @relation("VisitExceptionOwner")
  resolvedVisitExceptions   VisitException[]             @relation("VisitExceptionResolvedBy")
  sentVisitHandoffs         VisitHandoff[]               @relation("VisitHandoffFrom")
  receivedVisitHandoffs     VisitHandoff[]               @relation("VisitHandoffTo")
  createdVisitHandoffs      VisitHandoff[]               @relation("VisitHandoffCreatedBy")
  acknowledgedVisitHandoffs VisitHandoff[]               @relation("VisitHandoffAcknowledgedBy")
  delegatedVisitSignoffs    VisitRecordSignoffDelegate[] @relation("VisitSignoffDelegate")
  assignedVisitSignoffs     VisitRecordSignoffDelegate[] @relation("VisitSignoffAssignedBy")
  completedVisitDischarges  VisitDischarge[]             @relation("VisitDischargeCompletedBy")
  completedVisitCheckouts   VisitCheckout[]              @relation("VisitCheckoutCompletedBy")
  inventoryTransactions     InventoryTransaction[]
  createdInvoices           Invoice[]                    @relation("InvoiceCreatedBy")
  finalizedInvoices         Invoice[]                    @relation("InvoiceFinalizedBy")
  voidedInvoices            Invoice[]                    @relation("InvoiceVoidedBy")
  createdInvoiceLines       InvoiceLine[]                @relation("InvoiceLineCreatedBy")
  recordedPayments          Payment[]                    @relation("PaymentRecordedBy")
  patientMedicationEvents   PatientMedicationEvent[]     @relation("PatientMedicationEventActor")

  notes                              Note[]
  createdTasks                       Task[]
  assignedTasks                      Task[]                        @relation("TaskAssignee")
  createdConversations               MessagingConversation[]       @relation("MessagingConversationCreator")
  conversationMemberships            MessagingConversationMember[]
  sentMessages                       MessagingMessage[]            @relation("MessagingMessageSender")
  messageReactions                   MessagingReaction[]
  messageMentions                    MessagingMention[]
  messageEditEvents                  MessagingMessageEdit[]
  uploadedClinicalAttachments        ClinicalAttachment[]          @relation("ClinicalAttachmentUploadedBy")
  clinicalAttachmentEvents           ClinicalAttachmentEvent[]     @relation("ClinicalAttachmentEventActor")
  sentClientCommunicationMessages    ClientCommunicationMessage[]
  assignedClientCommunicationThreads ClientCommunicationThread[]

  invitationsSent    ClinicInvitation[]  @relation("InvitationInvitedBy")
  organizationEvents OrganizationEvent[] @relation("OrganizationEventActor")

  @@index([organizationId])
  @@index([organizationId, role])
}

// Staff-only attributes, kept off User so Client rows (the majority of
// User over time) don't carry a wall of nullable staff columns. Created for
// every non-CLIENT User; scheduling/visit-ownership/messaging all read from
// here rather than re-deriving capability from role.
model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique

  jobTitle      String?
  licenseNumber String?

  canReceiveAppointments Boolean @default(false)
  canOwnVisits           Boolean @default(false)

  // Calendar/roster color, e.g. "#4F46E5". Avatar image can reuse this field
  // later (URL) if photos are ever added — no separate column until then.
  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// --- Organization / location membership -----------------------------------
// ADR-006: normalized org- and location-level access grants, additive
// alongside the legacy User.organizationId/role/locations fields during the
// transition (those fields are not removed by this migration). A user is
// expected to hold at most one active OrganizationMembership in v1 — there is
// no multi-org switcher yet, so AuthService.resolveMembership treats more
// than one active row as an error rather than guessing which one to use.

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole
  // Kept alongside `status` below — always written together by the same
  // call site, never independently. `isActive` remains what every
  // pre-existing read site filters on (AuthService.resolveMembership,
  // appointment-availability.service.ts, scheduler-config.service.ts), so
  // this migration changes no existing query's behavior. `status` is the
  // richer value new team-management code should prefer (surfaces ACTIVE vs
  // DISABLED distinctly, and leaves room for future values without another
  // migration). A later migration can drop `isActive` once every read site
  // moves to `status`.
  isActive Boolean          @default(true)
  status   MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  invitation   ClinicInvitation?

  @@unique([organizationId, userId])
  @@index([userId])
}

// Location-level counterpart to OrganizationMembership — a user's role/access
// at one specific clinic location. Looked up scoped to the resolved
// OrganizationMembership's organizationId, per user.
model ClinicLocationAccess {
  id               String   @id @default(cuid())
  organizationId   String
  clinicLocationId String
  userId           String
  role             UserRole
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicLocation Location     @relation(fields: [clinicLocationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([clinicLocationId, userId])
  @@index([userId])
}

// --- Clinic invitations, membership audit trail, billing webhooks ---------
// docs/adr/ADR-007-clinic-provisioning-and-billing.md.

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A pending grant of clinic access for an email address that may not have a
// Sparki User yet. The clinic owner's own first membership is also created
// through this model (invitedByUserId null, role OWNER, system-generated by
// ClinicProvisioningService) — there is no separate "owner activation"
// concept; activating the owner account *is* accepting a ClinicInvitation.
// See InvitationsService.
//
// Expiration is intentionally not a stored status: "is this invitation still
// usable" is computed as `status = PENDING AND expiresAt > now()` at read
// time, so there is no background job keeping a stored status in sync.
model ClinicInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           UserRole
  suggestedFirstName String?
  suggestedLastName  String?

  // SHA-256 hex digest of the raw activation/invite token. The raw token is
  // only ever embedded in the emailed link, never stored — see
  // InvitationsService.issueToken. Looked up directly by this hash.
  tokenHash String @unique
  emailSentAt DateTime?

  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  // Null for the system-generated owner-founding invitation.
  invitedByUserId String?

  // Set once acceptance creates the resulting membership — an idempotency
  // marker as much as an audit pointer (see InvitationsService.accept, which
  // claims this row with a conditional update before creating anything).
  createdMembershipId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id])
  invitedBy         User?                   @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  createdMembership OrganizationMembership? @relation(fields: [createdMembershipId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, email])
}

enum OrganizationEventType {
  CLINIC_PROVISIONED
  OWNER_ACTIVATED
  INVITATION_CREATED
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_DISABLED
  MEMBERSHIP_REENABLED
  SUBSCRIPTION_STATUS_CHANGED
  CLINIC_PROFILE_UPDATED
  ONBOARDING_COMPLETED
}

// Structured audit log for clinic/membership/billing security-sensitive
// events (docs/blueprint/11-permission-and-ownership-v1.md "Audit
// Responsibility"). Mirrors the codebase's established per-domain event-log
// pattern (SchedulerConfigChange, VisitTransition, PatientMedicationEvent)
// rather than one cross-cutting table. `metadata` must never contain
// secrets, tokens, or full payment details — see individual call sites.
model OrganizationEvent {
  id             String                @id @default(cuid())
  organizationId String
  // Null for system/webhook-driven events (a Stripe subscription update has
  // no Sparki actor).
  actorUserId String?
  type        OrganizationEventType
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation("OrganizationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, type, createdAt])
}

// Dedupe/observability log for verified Stripe webhook deliveries. Primary
// key is the Stripe event id itself: BillingWebhookService inserts this row
// before processing and relies on the unique-constraint violation from a
// retried delivery to short-circuit idempotently. Deliberately not related
// to Organization by foreign key: a `checkout.session.completed` event must
// be insertable before the Organization it concerns necessarily exists.
model BillingWebhookEvent {
  id             String    @id
  type           String
  organizationId String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  error          String?
}

// --- Client / Patient -----------------------------------------------------
// docs/blueprint/08-core-domain-model-v1.md (Client, Patient) and
// docs/specs/modules/01-patient-workspace-mvp.md ("Client Context": primary +
// secondary client, so Patient<->Client is many-to-many with a primary flag).

model Client {
  id                     String  @id @default(cuid())
  organizationId         String
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  alternatePhone         String?
  preferredContactMethod String?

  // Structured owner address (Phase 2: address autocomplete). Kept as
  // discrete columns rather than one string so city/state/zip stay
  // queryable/reportable; formattedAddress is the provider's display string
  // (or a locally-built fallback — see formatClientAddress on the web side)
  // for showing the address as one line without hand-joining parts.
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  formattedAddress String?
  // Autocomplete provider's place id + coordinates, captured when a
  // suggestion is selected. Null for manually-typed addresses.
  addressPlaceId   String?
  addressLatitude  Float?
  addressLongitude Float?

  // Migration/provenance (see schema-level note above). Set only by a future
  // migration workflow; nullable because native (non-imported) records have
  // no source system.
  sourceSystem     String?
  sourceId         String?
  sourceConfidence Float?
  importedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization                @relation(fields: [organizationId], references: [id])
  patients             PatientClient[]
  appointments         Appointment[]
  visits               Visit[]
  communicationThreads ClientCommunicationThread[]
  clinicalAttachments  ClinicalAttachment[]
  invoices             Invoice[]
  // Fuzzy/substring matching for Patient Search's "search by client name";
  // expression index (not a plain column index) because the searchable name
  // is firstName || ' ' || lastName. See migration.sql for the raw
  // CREATE INDEX this can't express in Prisma schema syntax.

  @@index([organizationId])
}

enum PatientStatus {
  Active
  Inactive
  Deceased
  Transferred
  Unknown
}

model Patient {
  prescriptions PatientPrescription[]
  id             String        @id @default(cuid())
  organizationId String
  name           String
  // Pet last name is never shown or edited directly in the UI — it's
  // inherited automatically from the primary owner's Client.lastName (see
  // PatientsService.create / ClientsService.update). Kept only so search
  // and records can match on it.
  lastName       String?
  species        String
  breed          String?
  sex            String?
  dateOfBirth    DateTime?
  estimatedAge   String?
  weight         Float?
  color          String?
  imageUrl       String?
  // Object-storage key for an imageUrl produced by our own upload endpoint
  // (see PatientsService.uploadPhoto/getPhoto). Null when imageUrl is absent
  // or was set directly to an external URL instead of uploaded.
  imageStorageKey String?
  status         PatientStatus @default(Active)
  // Free-text clinical caution (allergies, handling notes, care cautions),
  // entered from the profile's Alerts tab — surfaced as a small badge next
  // to the patient's status pills and in the alert strip below the header.
  alerts         String?

  // Migration/provenance (see schema-level note above). Set only by a future
  // migration workflow; nullable because native (non-imported) records have
  // no source system.
  sourceSystem     String?
  sourceId         String?
  sourceConfidence Float?
  importedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization                @relation(fields: [organizationId], references: [id])
  clients              PatientClient[]
  appointments         Appointment[]
  visits               Visit[]
  medicalRecord        MedicalRecord?
  patientAlerts        PatientAlert[]
  medications          PatientMedication[]
  communicationThreads ClientCommunicationThread[]
  ClinicalAttachment   ClinicalAttachment[]
  invoices             Invoice[]

  @@index([organizationId])
  @@index([organizationId, name])
  // Fuzzy/substring matching for Patient Search's "search by patient name".
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  // Same, for the inherited/stored pet lastName (see PatientsService.search).
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum PatientAlertCategory {
  Behavior
  Allergy
  Handling
  Medical
  BillingAdmin
  Other
}

enum PatientAlertSeverity {
  Info
  Caution
  Critical
}

model PatientAlert {
  id             String               @id @default(cuid())
  organizationId String
  patientId      String
  message        String
  category       PatientAlertCategory @default(Other)
  severity       PatientAlertSeverity @default(Caution)
  isActive       Boolean              @default(true)
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId, isActive])
}

enum PatientMedicationStatus {
  Active
  Discontinued
  Completed
}

model PatientMedication {
  id             String                  @id @default(cuid())
  organizationId String
  patientId      String
  catalogItemId  String?                 @db.Uuid
  medicationName String
  genericName    String?
  strength       String?
  form           String?
  dose           String?
  route          String?
  frequency      String?
  instructions   String?
  startDate      DateTime?
  endDate        DateTime?
  status         PatientMedicationStatus @default(Active)
  prescribedBy   String?
  source         String?
  discontinueReason String?
  reactionNotes  String?
  lastRefilledAt DateTime?
  refillCount    Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  catalogItem  CatalogItem? @relation(fields: [catalogItemId], references: [id])
  events       PatientMedicationEvent[]

  @@index([organizationId, patientId, status])
  @@index([catalogItemId])
}

enum PatientMedicationEventType {
  CREATED
  EDITED
  REFILLED
  DISCONTINUED
  REACTION_FLAGGED
}

model PatientMedicationEvent {
  id             String                     @id @default(cuid())
  organizationId String
  medicationId   String
  actorId         String?
  type            PatientMedicationEventType
  reason          String?
  occurredAt      DateTime                   @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  medication   PatientMedication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  actor        User?             @relation("PatientMedicationEventActor", fields: [actorId], references: [id])

  @@index([organizationId, medicationId, occurredAt])
}

model PatientClient {
  patientId String
  clientId  String
  isPrimary Boolean @default(false)

  patient Patient @relation(fields: [patientId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@id([patientId, clientId])
}

// --- Appointment -----------------------------------------------------------
// docs/specs/modules/04-scheduling-mvp.md: required data, appointment types,
// and the closed MVP state model.

enum AppointmentType {
  WellnessPreventiveCare
  SickVisit
  Recheck
  TechnicianAppointment
  Vaccination
  SurgeryProcedure
  DropOff
  EmergencyUrgent
  Telemedicine
  Euthanasia
  BoardingNonMedical
}

enum AppointmentSource {
  Phone
  InClinic
  FollowUp
  Reminder
  ExternalIntegration
  Migration
  Other
}

enum AppointmentState {
  Draft
  Scheduled
  PreVisitPending
  Confirmed
  Arrived
  VisitCreated
  Completed
  Rescheduled
  Cancelled
  NoShow
}

// Tech/assistant records-research tracking — see Appointment.recordsPrepStatus.
enum RecordsPrepStatus {
  NotStarted
  Requested
  Received
  Reviewed
  NotAvailable
}

// Manual confirmation/reminder status tracking only — see Appointment.
// confirmationStatus. No messaging vendor is wired up; "SentManually" means
// staff confirmed by phone/in person and recorded it, not that Sparki sent
// anything.
enum ConfirmationStatus {
  NotSent
  Queued
  SentManually
  Confirmed
}

model Appointment {
  id                     String  @id @default(cuid())
  organizationId         String
  locationId             String
  // Nullable: "Appointment creation should be possible with provisional
  // Patient or Client when phone-call reality requires it" (scheduling spec).
  patientId              String?
  provisionalPatientName String?
  clientId               String?
  provisionalClientName  String?

  type   AppointmentType
  reason String
  source AppointmentSource
  state  AppointmentState  @default(Draft)

  scheduledAt              DateTime
  expectedDurationMinutes  Int?
  colorKey                 String?
  appointmentTypeSettingId String?
  schedulerSlotTemplateId  String?
  room                     String?

  // Records-request context gathered at booking time for a New Patient
  // (Anna's receptionist workflow) — all optional, since most existing-
  // patient bookings won't need them.
  primaryCareVetName    String?
  previousClinicName    String?
  previousRecordsSource String?
  lastSeenAt            DateTime?

  // Tech/assistant records-prep tracking (Anna: "researches available
  // medical records before the appointment") and receptionist-facing
  // confirmation/reminder status tracking (Anna: "confirmation and/or
  // reminder can be sent or queued"). Both are manual status fields only —
  // no messaging vendor is integrated, so ConfirmationStatus never implies a
  // message was actually delivered.
  recordsPrepStatus  RecordsPrepStatus  @default(NotStarted)
  confirmationStatus ConfirmationStatus @default(NotSent)

  providerId String?

  createdById String?

  // Migration/provenance (see schema-level note above). Set only by a future
  // migration workflow; nullable because native (non-imported) records have
  // no source system.
  sourceSystem     String?
  sourceId         String?
  sourceConfidence Float?
  importedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id])
  location               Location                @relation(fields: [locationId], references: [id])
  patient                Patient?                @relation(fields: [patientId], references: [id])
  client                 Client?                 @relation(fields: [clientId], references: [id])
  provider               User?                   @relation("AppointmentProvider", fields: [providerId], references: [id])
  appointmentTypeSetting AppointmentTypeSetting? @relation(fields: [appointmentTypeSettingId], references: [id])
  schedulerSlotTemplate  SchedulerSlotTemplate?  @relation(fields: [schedulerSlotTemplateId], references: [id], onDelete: SetNull)
  createdBy              User?                   @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  visit                  Visit?
  changes                AppointmentChange[]

  @@index([organizationId])
  @@index([locationId, scheduledAt])
  @@index([patientId])
  @@index([appointmentTypeSettingId])
  @@index([schedulerSlotTemplateId])
}

model AppointmentChange {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  appointmentId  String
  actorId        String?
  action         String
  reason         String?
  before         Json
  after          Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AppointmentChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([locationId, createdAt])
  @@index([appointmentId, createdAt])
}

model SchedulerConfigChange {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  actorId        String?
  entityType     String
  entityId       String
  action         String
  before         Json
  after          Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  actor        User?        @relation("SchedulerConfigChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([locationId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model AppointmentTypeSetting {
  id                     String           @id @default(cuid())
  organizationId         String
  locationId             String
  appointmentType        AppointmentType?
  name                   String
  description            String?
  defaultDurationMinutes Int
  color                  String
  isActive               Boolean          @default(true)
  sortOrder              Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization  Organization                  @relation(fields: [organizationId], references: [id])
  location      Location                      @relation(fields: [locationId], references: [id])
  providers     AppointmentTypeProvider[]
  appointments  Appointment[]
  slotTemplates AppointmentTypeSlotTemplate[]

  @@index([locationId, appointmentType])
  @@index([organizationId])
  @@index([locationId, isActive, sortOrder])
}

model AppointmentTypeProvider {
  appointmentTypeId String
  providerId        String
  organizationId    String
  createdAt         DateTime @default(now())

  appointmentType AppointmentTypeSetting @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
  provider        User                   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id])

  @@id([appointmentTypeId, providerId])
  @@index([organizationId])
  @@index([providerId])
}

// Explicit booking eligibility between a clinic-defined appointment style
// (for example "Spay") and a recurring schedule block. A style with at least
// one assignment may only be booked inside its assigned blocks; styles with
// no assignments retain the location's general availability.
model AppointmentTypeSlotTemplate {
  appointmentTypeId String
  slotTemplateId    String
  createdAt         DateTime @default(now())

  appointmentType AppointmentTypeSetting @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
  slotTemplate    SchedulerSlotTemplate  @relation(fields: [slotTemplateId], references: [id], onDelete: Cascade)

  @@id([appointmentTypeId, slotTemplateId])
  @@index([slotTemplateId])
}

// The Command Center dashboard's coarse status pill sequence (see
// operations-command-center.tsx's ReceptionStatus) — kept as its own enum
// rather than reusing AppointmentState/VisitState since it's a display-only
// concept, not a workflow state.
model DashboardStatusColorSetting {
  id                    String     @id @default(cuid())
  organizationId        String
  locationId            String
  status                String
  name                  String
  description           String?
  color                 String
  sortOrder             Int        @default(0)
  isEnabled             Boolean    @default(true)
  isInClinic            Boolean    @default(false)
  allowedTransitionKeys String[]   @default([])
  lifecyclePhase        VisitPhase @default(Arrived)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  visits       Visit[]      @relation("VisitWorkflowStep")

  @@unique([locationId, status])
  @@index([organizationId])
}

// Dashboard "Notes" widget — personal to the signed-in user, never shared
// with teammates, and kept indefinitely (no shift/expiry concept) until the
// user deletes it. sortOrder persists the widget's drag-to-reorder.
model Note {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  body           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, userId, sortOrder])
}

enum TaskStatus {
  Pending
  Completed
}

// Dashboard "Tasks" work queue — org/location shared (unlike Note above).
// "Overdue" is deliberately not a stored status: it's derived at read time
// from a Pending task whose dueAt has passed, so a task can't get stuck in
// a stale Overdue state after its due date is edited.
model Task {
  id             String     @id @default(cuid())
  organizationId String
  locationId     String
  title          String
  // Denormalized display-name snapshot (avoids a join for the common case
  // of just rendering the task list) — assigneeId below is the source of
  // truth for "who is allowed to complete this task" (see TasksService).
  assignee       String
  // Nullable only so a pre-assigneeId row (created before this column
  // existed) doesn't break; every task created through the current UI
  // always sets it, since assignment now comes from a real staff picker.
  assigneeId     String?
  assignedBy     String
  dueAt          DateTime?
  status         TaskStatus @default(Pending)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  assigneeUser User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([organizationId, locationId, status])
  @@index([assigneeId])
}

enum MessagingConversationType {
  DIRECT
  GROUP
  CLINIC_CHANNEL
  DEPARTMENT_CHANNEL
  LOCATION_CHANNEL
  PRIVATE_CHANNEL
}

enum MessagingNotificationLevel {
  ALL
  MENTIONS
  MUTED
}

enum MessagingRecordType {
  PATIENT
  CLIENT
  APPOINTMENT
  VISIT
  TASK
  MEDICAL_RECORD
  DOCUMENT
}

model MessagingConversation {
  id             String                    @id @default(cuid())
  organizationId String
  locationId     String?
  type           MessagingConversationType
  name           String?
  description    String?
  isPrivate      Boolean                   @default(false)
  createdById    String
  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization                  @relation(fields: [organizationId], references: [id])
  location     Location?                     @relation(fields: [locationId], references: [id])
  createdBy    User                          @relation("MessagingConversationCreator", fields: [createdById], references: [id])
  members      MessagingConversationMember[]
  messages     MessagingMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([organizationId, locationId])
}

model MessagingConversationMember {
  id                String                     @id @default(cuid())
  organizationId    String
  conversationId    String
  userId            String
  notificationLevel MessagingNotificationLevel @default(ALL)
  isPinned          Boolean                    @default(false)
  isArchived        Boolean                    @default(false)
  markedUnread      Boolean                    @default(false)
  lastReadAt        DateTime?
  draft             String                     @default("")
  drawerOpen        Boolean                    @default(false)
  drawerMinimized   Boolean                    @default(false)
  joinedAt          DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  conversation MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([organizationId, userId, isArchived])
}

model MessagingMessage {
  id             String    @id @default(cuid())
  organizationId String
  conversationId String
  senderId       String
  clientNonce    String?
  body           String
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  conversation MessagingConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                   @relation("MessagingMessageSender", fields: [senderId], references: [id])
  replyTo      MessagingMessage?      @relation("MessagingReplies", fields: [replyToId], references: [id])
  replies      MessagingMessage[]     @relation("MessagingReplies")
  reactions    MessagingReaction[]
  mentions     MessagingMention[]
  attachments  MessagingAttachment[]
  editHistory  MessagingMessageEdit[]

  @@unique([conversationId, clientNonce])
  @@index([organizationId, conversationId, createdAt])
}

model MessagingReaction {
  id             String   @id @default(cuid())
  organizationId String
  messageId      String
  userId         String
  emoji          String
  createdAt      DateTime @default(now())

  message MessagingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([organizationId, messageId])
}

model MessagingMention {
  id             String   @id @default(cuid())
  organizationId String
  messageId      String
  userId         String
  createdAt      DateTime @default(now())

  message MessagingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([organizationId, userId])
}

model MessagingAttachment {
  id             String               @id @default(cuid())
  organizationId String
  messageId      String
  fileName       String?
  mimeType       String?
  sizeBytes      Int?
  storageKey     String?
  recordType     MessagingRecordType?
  recordId       String?
  previewLabel   String?
  previewDetail  String?
  href           String?
  createdAt      DateTime             @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  message      MessagingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, messageId])
  @@index([organizationId, recordType, recordId])
}

model MessagingMessageEdit {
  id             String   @id @default(cuid())
  organizationId String
  messageId      String
  editorId       String
  previousBody   String
  action         String
  createdAt      DateTime @default(now())

  message MessagingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editor  User             @relation(fields: [editorId], references: [id])

  @@index([organizationId, messageId, createdAt])
}

enum ClientCommunicationDirection {
  INBOUND
  OUTBOUND
}

enum ClientCommunicationStatus {
  OPEN
  WAITING
  CLOSED
}

model ClientCommunicationThread {
  id             String                    @id @default(cuid())
  organizationId String
  locationId     String
  clientId       String
  patientId      String?
  assignedToId   String?
  phone          String
  status         ClientCommunicationStatus @default(OPEN)
  isUnread       Boolean                   @default(false)
  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id])
  location     Location                     @relation(fields: [locationId], references: [id])
  client       Client                       @relation(fields: [clientId], references: [id])
  patient      Patient?                     @relation(fields: [patientId], references: [id])
  assignedTo   User?                        @relation(fields: [assignedToId], references: [id])
  messages     ClientCommunicationMessage[]

  @@index([organizationId, locationId, lastMessageAt])
  @@index([organizationId, clientId])
}

model ClientCommunicationMessage {
  id             String                       @id @default(cuid())
  organizationId String
  threadId       String
  senderUserId   String?
  direction      ClientCommunicationDirection
  body           String
  providerId     String?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  createdAt      DateTime                     @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id])
  thread       ClientCommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser   User?                     @relation(fields: [senderUserId], references: [id])

  @@unique([threadId, providerId])
  @@index([organizationId, threadId, createdAt])
}

model SchedulerSettings {
  id                  String   @id @default(cuid())
  organizationId      String
  locationId          String   @unique
  slotIntervalMinutes Int      @default(30)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@index([organizationId])
}

model SchedulerSlotTemplate {
  id                    String    @id @default(cuid())
  organizationId        String
  locationId            String
  dayOfWeek             Int
  startTime             String
  endTime               String
  label                 String
  color                 String
  staffId               String?
  room                  String?
  isActive              Boolean   @default(true)
  isGeneralAvailability Boolean   @default(true)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization     Organization                  @relation(fields: [organizationId], references: [id])
  location         Location                      @relation(fields: [locationId], references: [id])
  appointmentTypes AppointmentTypeSlotTemplate[]
  appointments     Appointment[]

  @@index([organizationId])
  @@index([locationId, dayOfWeek, isActive])
  @@index([locationId, deletedAt])
}

// --- Visit -------------------------------------------------------------
// docs/specs/modules/02-visit-lifecycle-mvp.md: entry sources and the closed
// 47-state MVP state machine (Visit State is a property of Visit, not a
// separate object, per docs/blueprint/08-core-domain-model-v1.md).

enum VisitType {
  Scheduled
  WalkIn
  Emergency
  DropOff
  Telemedicine
  TechnicianAppointment
  SurgeryAdmission
  HospitalizationContinuation
  FollowUp
}

enum VisitState {
  IntentCreated
  Scheduled
  PreVisitPending
  Confirmed
  Arrived
  CheckInInProgress
  ArrivedWithExceptions
  Triaged
  Waiting
  ReadyForIntake
  IntakeInProgress
  VeterinarianExamReady
  VeterinarianExamInProgress
  PlanDrafted
  EstimateNeeded
  EstimatePrepared
  ClientApprovalPending
  Approved
  PartiallyApproved
  Declined
  DiagnosticsPending
  DiagnosticsInProgress
  ResultsPending
  ResultsReady
  VeterinarianReviewPending
  TreatmentPending
  TreatmentInProgress
  TreatmentComplete
  MedicationPending
  ClientCommunicationPending
  FollowUpPending
  CheckoutReady
  CheckoutInProgress
  PaymentPending
  PaymentComplete
  RecordCompletionPending
  RecordComplete
  VisitClosing
  VisitClosingWithExceptions
  Archived
  ArchivedWithExceptions
  Cancelled
  CancelledAfterArrival
  NoShow
  Rescheduled
  Referred
  Deferred
}

enum VisitPhase {
  Arrived
  Intake
  Exam
  PlanAndApproval
  CareInProgress
  Discharge
  RecordClosure
  Closed
}

enum VisitTransitionSource {
  User
  System
  Integration
  Migration
}

enum VisitWorkItemType {
  IntakeCompletion
  Diagnostic
  Estimate
  ClientApproval
  Treatment
  Medication
  ClientCommunication
  FollowUp
  Payment
  RecordSignoff
}

enum VisitWorkItemStatus {
  Pending
  InProgress
  Completed
  Declined
  Deferred
  Cancelled
}

enum VisitExceptionSeverity {
  Info
  Warning
  Critical
}

model Visit {
  id             String  @id @default(cuid())
  organizationId String
  locationId     String
  patientId      String
  clientId       String?
  appointmentId  String? @unique

  visitType VisitType
  reason    String
  state     VisitState @default(IntentCreated)
  phase     VisitPhase @default(Arrived)
  version   Int        @default(1)

  // Workflow ownership (whoever's queue this Visit currently sits in) — may
  // differ from the care team below, e.g. a front desk user owns intake
  // before a veterinarian is assigned. All nullable: not every Visit has an
  // assigned care team yet (e.g. a walk-in before triage), and existing rows
  // predate these columns.
  currentOwnerId        String?
  primaryVeterinarianId String?
  assignedTechnicianId  String?
  createdById           String?
  lastUpdatedById       String?
  nextAction            String?

  archivedAt       DateTime?
  arrivedAt        DateTime?
  intakeStartedAt  DateTime?
  examStartedAt    DateTime?
  dischargeReadyAt DateTime?
  departedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization        Organization                 @relation(fields: [organizationId], references: [id])
  location            Location                     @relation(fields: [locationId], references: [id])
  patient             Patient                      @relation(fields: [patientId], references: [id])
  client              Client?                      @relation(fields: [clientId], references: [id])
  appointment         Appointment?                 @relation(fields: [appointmentId], references: [id])
  currentOwner        User?                        @relation("VisitOwner", fields: [currentOwnerId], references: [id])
  primaryVeterinarian User?                        @relation("VisitPrimaryVeterinarian", fields: [primaryVeterinarianId], references: [id])
  assignedTechnician  User?                        @relation("VisitAssignedTechnician", fields: [assignedTechnicianId], references: [id])
  createdBy           User?                        @relation("VisitCreatedBy", fields: [createdById], references: [id])
  lastUpdatedBy       User?                        @relation("VisitLastUpdatedBy", fields: [lastUpdatedById], references: [id])
  medicalRecord       MedicalRecord?               @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId     String?
  soapNotes           SoapNote[]
  intake              VisitIntake?
  examFindings        VisitExamFindings?
  transitions         VisitTransition[]
  workItems           VisitWorkItem[]
  exceptions          VisitException[]
  handoffs            VisitHandoff[]
  signoffDelegates    VisitRecordSignoffDelegate[]
  discharge           VisitDischarge?
  checkout            VisitCheckout?
  invoice             Invoice?
  workflowStep        DashboardStatusColorSetting? @relation("VisitWorkflowStep", fields: [workflowStepId], references: [id], onDelete: SetNull)
  workflowStepId      String?
  workItemChanges     VisitWorkItemChange[]
  clinicalAttachments ClinicalAttachment[]

  @@index([organizationId])
  @@index([patientId])
  @@index([state])
  @@index([primaryVeterinarianId])
  @@index([assignedTechnicianId])
  @@index([organizationId, locationId, phase])
  @@index([workflowStepId])
}

model ClinicalAttachment {
  id             String    @id @default(cuid())
  organizationId String
  locationId     String
  patientId      String?
  visitId        String?
  fileName       String
  mimeType       String
  sizeBytes      Int
